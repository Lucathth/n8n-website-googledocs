# Vorlage für die lokale Dev-Umgebung (`netlify dev`) bzw. die Netlify-Umgebungsvariablen.
# Kopieren nach .env und Werte eintragen. Hashes erzeugen mit:
#   node -e "console.log(require('crypto').createHash('sha256').update('DEIN-PASSWORT').digest('hex'))"

# Abacus HR Services
PASSWORD_HASH_HRSERVICES=
WEBHOOK_CREATE_HRSERVICES=

# Abacus Umantis
PASSWORD_HASH_UMANTIS=
WEBHOOK_CREATE_UMANTIS=

# Gemeinsames Secret, aus dem die markengebundenen Session-Tokens abgeleitet werden
API_TOKEN=
